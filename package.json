{
  "name": "ai-ticket-it",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:backend": "npm start --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "start:frontend": "npm start --workspace=frontend",
    "start:dev": "concurrently \"npm run dev:backend\" \"npm run start:frontend\"",
    "lint": "eslint .",
    "format": "prettier . --write",
    "test": "npm test --workspaces --if-present",
    "seed": "npm run seed --workspace=backend"
  },
  "license": "ISC",
  "description": "AI Ticket It: plataforma de venta de entradas para eventos",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "react-native-worklets": "0.13.0"
  }
}
