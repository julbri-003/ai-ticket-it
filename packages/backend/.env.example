PORT=8000
JWT_SECRET=cambiame-por-un-secreto-largo
JWT_EXPIRES_IN=7d
# Orígenes permitidos por CORS, separados por coma. Vacío = cualquiera (Expo Go no envía Origin).
ALLOWED_ORIGINS=
# Vacío = MongoDB en memoria (mongodb-memory-server). Completar solo para debug con una base real.
MONGO_URI=
INTERVALO_JOBS_MS=60000
UPLOADS_DIR=uploads
# Base para armar URLs absolutas de imágenes y videos (vacío = se infiere del request).
# Desde el celular: http://<IP-LAN-de-la-PC>:8000
PUBLIC_BASE_URL=
