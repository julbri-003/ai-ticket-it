# URL del back que usa la app. Copiá este archivo a .env y ajustá la IP.
#
# - Celular con Expo Go: usá la IP LAN de tu PC (ipconfig en Windows → "Dirección IPv4").
#   El celular y la PC tienen que estar en la misma red Wi-Fi.
#     EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/api
# - Emulador de Android: 10.0.2.2 apunta al localhost de la PC.
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
# - Navegador web / simulador de iOS en la misma PC: localhost.
#     EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/api
